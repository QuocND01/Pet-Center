@using PetCenterClient.ViewModels
@model IEnumerable<ReadVetPetListViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Pet Directory";
}

<style>
    .pagination {
        margin-top: 20px;
        display: flex;
        gap: 6px;
    }

    .data-table {
        overflow: hidden !important;
    }

    .page-btn {
        padding: 6px 12px;
        background: #eee;
        border-radius: 6px;
        text-decoration: none;
    }

        .page-btn.active {
            background: #4f46e5;
            color: white;
        }

    .btn-add-product {
        border: none;
        background: #16a34a;
        color: white;
        border-radius: 10px;
        padding: 11px 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: .2s;
    }

        .btn-add-product:hover {
            background: #15803d;
        }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* 3 Cột actions (Hồ sơ bệnh án, Sửa, Xóa) */
    .action-grid {
        display: grid;
        grid-template-columns: repeat(3, 40px);
        gap: 8px;
        justify-content: center;
    }

    .data-table th, .data-table td {
        vertical-align: middle;
    }

    /* Avatar Pet */
    .pet-avatar-wrap {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

        .pet-avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

<link rel="stylesheet" href="~/css/AdminViews/BaseManageLayout.css" asp-append-version="true" />

<div class="page-wrapper">
    <!-- HEADER -->
    <div class="page-header">
        <div class="page-title-group">
            <h1>Clinic Patients</h1>
            <p>Manage registered patients and clinic records</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn-add-product" onclick="openVetMutateModal(null)">
                <i class="bi bi-plus-lg"></i>
                Register New Patient
            </button>
        </div>
    </div>

    <!-- TOOLBAR -->
    <form method="get" action="/VetPets/Index" class="toolbar">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text"
                   name="search"
                   class="search-input"
                   placeholder="Search by breed, species, or owner name..."
                   value="@ViewBag.SearchKeyword" />
        </div>

        <button type="submit" class="filter-btn active">
            Search
        </button>

        @if (!string.IsNullOrEmpty(ViewBag.SearchKeyword))
        {
            <a href="/VetPets/Index" class="filter-btn" style="text-decoration:none; text-align:center;">
                Clear
            </a>
        }
    </form>

    <!-- TABLE -->
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="ps-4">Pet Info</th>
                    <th>Species / Breed</th>
                    <th>Age / Gender</th>
                    <th>Owner Info</th>
                    <th style="width:180px; text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var pet in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="pet-avatar-wrap">
                                        @if (!string.IsNullOrEmpty(pet.PetAvatar))
                                        {
                                            <img src="@pet.PetAvatar" alt="@pet.PetName" />
                                        }
                                        else
                                        {
                                            <span class="fs-5">@(pet.Species.ToLower() == "cat" ? "🐱" : "🐶")</span>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark mb-1">@pet.PetName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@pet.Species</div>
                                <small class="text-muted">@pet.Breed</small>
                            </td>
                            <td>
                                <div class="mb-1">@pet.Gender</div>
                                <span class="badge bg-secondary">@pet.Age</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">👤 @pet.OwnerName</div>
                                <small class="text-muted">📞 @pet.OwnerPhone</small>
                            </td>
                            <td>
                                <div class="action-grid">
                                    <!-- MEDICAL PROFILE -->
                                    <button class="btn-detail btn-view-vet-pet text-primary" data-id="@pet.PetId" title="Medical Profile">
                                        <i class="bi bi-file-medical"></i>
                                    </button>

                                    <!-- EDIT -->
                                    <button class="btn-detail" onclick="openVetMutateModal('@pet.PetId')" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- DELETE -->
                                    <button class="btn-detail text-danger" onclick="deleteVetPet('@pet.PetId')" title="Delete (soft delete)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-clipboard-x"></i>
                                </div>
                                <h3>No patient records found</h3>
                                <p>Try adjusting your search criteria</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MEDICAL PROFILE MODAL -->
<div class="modal fade" id="vetPetDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border:none;" id="vetPetModalBody"></div>
    </div>
</div>

<!-- REGISTER / UPDATE MODAL -->
<div class="modal fade" id="vetMutatePetModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border:none; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
            <div class="modal-body p-4">
                <div class="edit-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h3 class="page-title mb-0" id="vetMutateModalTitle">Register Patient</h3>
                            <p class="page-subtitle text-muted">Create or update patient record</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <input type="hidden" id="vMutPetId" />

                    <div class="row g-3">
                        <div class="col-12" id="customerInputGroup">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">OWNER</label>
                            <select id="vMutCustomerId" class="form-select">
                                <option value="">-- Select an owner --</option>
                            </select>
                            <small class="text-warning">* Required when registering a new pet.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">PET NAME</label>
                            <input type="text" id="vMutPetName" class="form-control" placeholder="Pet's name">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">PET AVATAR</label>
                            <input type="file" id="vMutImage" class="form-control" accept="image/*">
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">SPECIES</label>
                            <select id="vMutSpecies" class="form-select">
                                <option value="Dog">Dog</option>
                                <option value="Cat">Cat</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">GENDER</label>
                            <select id="vMutGender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">BREED</label>
                            <input type="text" id="vMutBreed" class="form-control" placeholder="e.g. Golden Retriever">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">BIRTHDAY</label>
                            <input type="date" id="vMutDob" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">WEIGHT (kg)</label>
                            <input type="number" step="0.1" id="vMutWeight" class="form-control" placeholder="0.0">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">MEDICAL NOTES</label>
                            <textarea id="vMutNote" class="form-control" rows="2" placeholder="Any known allergies or conditions..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary btn-cancel px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning btn-update px-4 text-dark fw-bold" style="border-radius: 8px; background: #f59e0b; border: none;" onclick="saveVetPet()">Save Record</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Shared helper to populate modal inputs for pet mutate forms (copied here so admin view can use it)
        function populatePetModal(data, prefix) {
            const v = (obj, camel, pascal) => (obj && obj[camel] !== undefined ? obj[camel] : (obj && pascal && obj[pascal] !== undefined ? obj[pascal] : undefined));
            const set = (id, value) => { const el = document.getElementById(id); if (el) el.value = value ?? ''; };

            set(prefix + 'PetName', v(data, 'petName', 'PetName') || '');
            set(prefix + 'Species', v(data, 'species', 'Species') || 'Dog');
            set(prefix + 'Breed', v(data, 'breed', 'Breed') || '');
            set(prefix + 'Gender', v(data, 'gender', 'Gender') || 'Male');

            const dobVal = v(data, 'dateOfBirth', 'DateOfBirth');
            if (dobVal) {
                const dt = new Date(dobVal);
                if (!isNaN(dt)) {
                    const month = (dt.getMonth() + 1).toString().padStart(2, '0');
                    const day = dt.getDate().toString().padStart(2, '0');
                    set(prefix + 'Dob', dt.getFullYear() + '-' + month + '-' + day);
                } else {
                    set(prefix + 'Dob', '');
                }
            } else {
                set(prefix + 'Dob', '');
            }

            set(prefix + 'Weight', (v(data, 'weight', 'Weight') ?? ''));
            set(prefix + 'Note', (v(data, 'note', 'Note') ?? ''));
        }

        document.addEventListener("click", function (e) {
            var btnView = e.target.closest(".btn-view-vet-pet");
            if (btnView) {
                var petId = btnView.getAttribute("data-id");
                var modalBody = document.getElementById("vetPetModalBody");
                var modal = new bootstrap.Modal(document.getElementById('vetPetDetailModal'));
                modalBody.innerHTML = "<div class='text-center py-5'><div class='spinner-border text-primary'></div></div>";
                modal.show();
                fetch('/VetPets/Details/' + petId)
                    .then(r => r.text())
                    .then(html => modalBody.innerHTML = html);
            }
        });

        function deleteVetPet(id) {
            if (confirm("Are you sure you want to delete this patient's record? This is a soft delete.")) {
                fetch('/VetPets/Delete/' + id, { method: 'POST' })
                .then(r => r.json())
                .then(d => {
                    if (d.success) location.reload();
                    else alert("Failed to delete.");
                });
            }
        }

        var vetMutateModal;
        function openVetMutateModal(id) {
            if (!vetMutateModal) vetMutateModal = new bootstrap.Modal(document.getElementById('vetMutatePetModal'));
            document.getElementById('vMutPetId').value = id || '';
            document.getElementById('vetMutateModalTitle').innerText = id ? 'Edit Patient Record' : 'Register New Patient';

            document.getElementById('customerInputGroup').style.display = id ? 'none' : 'block';

            // Reset file input
            document.getElementById('vMutImage').value = '';

            if (!id) {
                document.getElementById('vMutCustomerId').value = '';
                document.getElementById('vMutPetName').value = '';
                document.getElementById('vMutBreed').value = '';
                document.getElementById('vMutDob').value = '';
                document.getElementById('vMutWeight').value = '';
                document.getElementById('vMutNote').value = '';
                vetMutateModal.show();
            } else {
                // editing: fetch pet details from API and prefill
                fetch('/VetPets/GetJson/' + id)
                    .then(r => { if (!r.ok) throw new Error('failed'); return r.json(); })
                    .then(data => {
                        populatePetModal(data, 'vMut');
                    })
                    .catch(err => console.log('[openVetMutateModal] fetch error', err))
                    .finally(() => vetMutateModal.show());
            }
            // Load customers into select when opening for create
            if (!id) {
                fetch('/Customer/GetAll')
                    .then(r => r.json())
                    .then(list => {
                        var sel = document.getElementById('vMutCustomerId');
                        sel.innerHTML = '<option value="">-- Select an owner --</option>';
                        list.forEach(function (c) {
                            var opt = document.createElement('option');
                            opt.value = c.id;
                            opt.text = c.text;
                            sel.appendChild(opt);
                        });
                    });
            }
        }

        function saveVetPet() {
            var id = document.getElementById('vMutPetId').value;
            var customerId = document.getElementById('vMutCustomerId').value;
            var petName = document.getElementById('vMutPetName').value;

            if(!id && !customerId) return alert("Please select an owner for new pets!");
            if(!petName) return alert("Pet name is required!");
            if(!document.getElementById('vMutBreed').value) return alert("Breed is required!");

            // Dùng FormData thay vì JSON
            var formData = new FormData();
            formData.append('Species', document.getElementById('vMutSpecies').value);
            formData.append('Gender', document.getElementById('vMutGender').value);
            formData.append('Breed', document.getElementById('vMutBreed').value);
            formData.append('PetName', petName);

            var dob = document.getElementById('vMutDob').value;
            if(dob) formData.append('DateOfBirth', dob);

            var weight = document.getElementById('vMutWeight').value;
            if(weight) formData.append('Weight', weight);

            var note = document.getElementById('vMutNote').value;
            if(note) formData.append('Note', note);

            // Nạp file ảnh nếu có
            var fileInput = document.getElementById('vMutImage');
            if (fileInput.files.length > 0) {
                formData.append('ImageFile', fileInput.files[0]);
            }

            var url = id ? '/VetPets/Update/' + id : '/VetPets/Add?customerId=' + customerId;

            fetch(url, {
                method: 'POST',
                body: formData // Không set header Content-Type
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) location.reload();
                else alert("Failed to save.");
            });
        }
    </script>
}