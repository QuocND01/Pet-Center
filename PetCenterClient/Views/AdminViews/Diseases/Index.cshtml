@using PetCenterClient.ViewModels
@model IEnumerable<ReadDiseaseViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Disease Dictionary";
}

<style>
    .pagination {
        margin-top: 20px;
        display: flex;
        gap: 6px;
    }

    .page-btn {
        padding: 6px 12px;
        background: #eee;
        border-radius: 6px;
        text-decoration: none;
    }

        .page-btn.active {
            background: #4f46e5;
            color: white;
        }

    .btn-add-product {
        border: none;
        background: #16a34a;
        color: white;
        border-radius: 10px;
        padding: 11px 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: .2s;
    }

        .btn-add-product:hover {
            background: #15803d;
        }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Đổi thành 3 cột vì trang Disease có 3 actions (View, Edit, Delete) */
    .action-grid {
        display: grid;
        grid-template-columns: repeat(3, 40px);
        gap: 8px;
        justify-content: center;
    }

    /* Giới hạn nội dung cột Disease Name */
    .data-table td:nth-child(1) {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .data-table th, .data-table td {
        vertical-align: middle;
    }
</style>

<link rel="stylesheet" href="~/css/AdminViews/BaseManageLayout.css" asp-append-version="true" />

<div class="page-wrapper">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-title-group">
            <h1>Medical Disease Dictionary</h1>
            <p>Manage disease entries, symptoms and recommendations</p>
        </div>

        <div class="header-actions">
            <button type="button" class="btn-add-product" onclick="openMutateModal(null)">
                <i class="bi bi-plus-lg"></i>
                Add Disease
            </button>
        </div>
    </div>

    <!-- TOOLBAR -->
    <form method="get" action="/Diseases/Index" class="toolbar">
        <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text"
                   name="search"
                   value="@ViewBag.SearchKeyword"
                   class="search-input"
                   placeholder="Search disease name..." />
        </div>

        <select name="species" class="filter-select" style="max-width: 180px;">
            <option value="">All Species</option>
            <option value="1" selected="@(ViewBag.SelectedSpecies == 1 ? "selected" : null)">Dog 🐶</option>
            <option value="2" selected="@(ViewBag.SelectedSpecies == 2 ? "selected" : null)">Cat 🐱</option>
            <option value="3" selected="@(ViewBag.SelectedSpecies == 3 ? "selected" : null)">Both 🐾</option>
        </select>

        <button type="submit" class="filter-btn active">
            Search
        </button>

        @if (!string.IsNullOrEmpty(ViewBag.SearchKeyword) || ViewBag.SelectedSpecies != null)
        {
            <a href="/Diseases/Index" class="filter-btn" style="text-decoration:none; text-align:center;">
                Clear
            </a>
        }
    </form>

    <!-- TABLE -->
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="ps-4">Disease Name</th>
                    <th>Target Species</th>
                    <th>Type</th>
                    <th style="width:180px; text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                @item.Name
                            </td>

                            <td>
                                <span class="badge bg-secondary">@item.SpeciesName</span>
                            </td>

                            <td>
                                @if (item.IsSystem)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-shield-lock"></i> System</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Custom</span>
                                }
                            </td>

                            <td>
                                <div class="action-grid">
                                    <!-- VIEW -->
                                    <button class="btn-detail btn-view-disease" data-id="@item.DiseaseId" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    @if (!item.IsSystem)
                                    {
                                        <!-- EDIT -->
                                        <button class="btn-detail" onclick="openMutateModal('@item.DiseaseId', '@item.Name', '@item.Species', '@item.IsSystem')" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <!-- DELETE -->
                                        <button class="btn-detail text-danger" onclick="deleteDisease('@item.DiseaseId')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- DISABLED EDIT -->
                                        <button class="btn-detail text-muted disabled" title="System data cannot be edited" style="cursor: not-allowed; opacity: 0.5;">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-heart-pulse"></i>
                                </div>
                                <h3>No diseases found</h3>
                                <p>Try adjusting your search or filters</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DISEASE DETAIL MODAL -->
<div class="modal fade" id="diseaseDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border:none;" id="diseaseModalBody"></div>
    </div>
</div>

<!-- MUTATE DISEASE MODAL -->
<div class="modal fade" id="mutateDiseaseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px; border:none; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
            <div class="modal-body p-4">
                <div class="edit-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h3 class="page-title mb-0" id="mutateModalTitle">Add Disease</h3>
                            <p class="page-subtitle text-muted">Manage disease information and recommendations</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <input type="hidden" id="mutDiseaseId" />

                    <div id="systemWarning" class="alert alert-warning d-none" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> You are editing a System Default disease. Be careful!
                    </div>

                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">DISEASE NAME</label>
                            <input type="text" id="mutName" class="form-control">
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">TARGET SPECIES</label>
                            <select id="mutSpecies" class="form-select">
                                <option value="1">Dog</option>
                                <option value="2">Cat</option>
                                <option value="3">Both (Dog & Cat)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">DESCRIPTION / SYMPTOMS</label>
                            <textarea id="mutDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #6b7280;">TREATMENT RECOMMENDATION</label>
                            <textarea id="mutRecommendation" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary btn-cancel px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning btn-update px-4 text-dark fw-bold" style="border-radius: 8px; background: #f59e0b; border: none;" onclick="saveDisease()">Save Disease</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khởi tạo hiển thị Modal Detail
        document.addEventListener("click", function (e) {
            var btnView = e.target.closest(".btn-view-disease");
            if (btnView) {
                var diseaseId = btnView.getAttribute("data-id");
                var modalBody = document.getElementById("diseaseModalBody");
                var modal = new bootstrap.Modal(document.getElementById('diseaseDetailModal'));
                modalBody.innerHTML = "<div class='text-center py-5'><div class='spinner-border text-primary'></div></div>";
                modal.show();
                fetch('/Diseases/Details/' + diseaseId)
                    .then(r => r.text())
                    .then(html => modalBody.innerHTML = html);
            }
        });

        function deleteDisease(id) {
            if (confirm("Are you sure you want to delete this custom disease?")) {
                fetch('/Diseases/Delete/' + id, { method: 'POST' })
                .then(r => r.json())
                .then(d => {
                    if (d.success) location.reload();
                    else alert("Failed to delete. It might be a system disease.");
                });
            }
        }

        var mutateModal;
        function openMutateModal(id, name, species, isSystem) {
            if (!mutateModal) mutateModal = new bootstrap.Modal(document.getElementById('mutateDiseaseModal'));

            document.getElementById('mutDiseaseId').value = id || '';
            document.getElementById('mutateModalTitle').innerText = id ? 'Edit Disease' : 'Add New Disease';

            var nameInput = document.getElementById('mutName'); // Lấy element của Disease Name

            if (!id) {
                // Add mới
                nameInput.value = '';
                nameInput.readOnly = false; // Cho phép nhập khi thêm mới
                document.getElementById('mutSpecies').value = '3'; // Default both
                document.getElementById('mutDescription').value = '';
                document.getElementById('mutRecommendation').value = '';
                document.getElementById('systemWarning').classList.add('d-none');
            } else {
                // Edit: Đổ tạm tên và loài vào form
                nameInput.value = name;
                nameInput.readOnly = true;  // Chỉ đọc (không cho sửa) khi cập nhật
                document.getElementById('mutSpecies').value = species;

                if(isSystem === 'True') document.getElementById('systemWarning').classList.remove('d-none');
                else document.getElementById('systemWarning').classList.add('d-none');

                // Fetch full disease details to pre-fill description and recommendation
                fetch('/Diseases/GetJson/' + id)
                    .then(r => r.ok ? r.json() : null)
                    .then(d => {
                        if (d) {
                            document.getElementById('mutDescription').value = d.description || '';
                            document.getElementById('mutRecommendation').value = d.recommendation || '';
                        }
                    })
                    .catch(() => {
                        // ignore fetch errors, fields remain as-is
                    });
            }
            mutateModal.show();
        }

        function saveDisease() {
            var id = document.getElementById('mutDiseaseId').value;
            var data = {
                name: document.getElementById('mutName').value,
                species: parseInt(document.getElementById('mutSpecies').value),
                description: document.getElementById('mutDescription').value,
                recommendation: document.getElementById('mutRecommendation').value
            };

            if(!data.name) return alert("Disease Name is required!");

            var url = id ? '/Diseases/Update/' + id : '/Diseases/Add';

            // Gửi dạng JSON (không có ảnh)
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) location.reload();
                else alert("Lỗi từ Backend API:\n\n" + (d.message || "Failed to save."));
            });
        }
    </script>
}