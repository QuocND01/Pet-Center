@using Microsoft.AspNetCore.Http
@model IEnumerable<PetCenterClient.ViewModels.Appointment.AppointmentListViewModel>

@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // 🔑 Lấy StaffId trực tiếp từ Session
    var staffIdSession = Context.Session.GetString("StaffId")
                      ?? Context.Session.GetString("UserId");

    Guid currentStaffId = Guid.TryParse(staffIdSession, out var parsedGuid) ? parsedGuid : Guid.Empty;

    // Trích xuất danh sách Doctor duy nhất cho Dropdown Lọc
    var doctorList = Model?
        .Where(x => !string.IsNullOrEmpty(x.VetName))
        .Select(x => x.VetName)
        .Distinct()
        .OrderBy(x => x)
        .ToList() ?? new List<string>();

    // Chuẩn bị mốc thời gian Hôm nay và Ngày mai (so sánh theo Date)
    var today = DateTime.Today;
    var tomorrow = today.AddDays(1);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    .admin-console-wrapper {
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    .status-badge {
        padding: 0.5rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-block;
    }

    .badge-status-0 {
        background-color: #ffe5e5;
        color: #cc0000;
    }

    .badge-status-1 {
        background-color: #fff3cd;
        color: #856404;
    }

    .badge-status-2 {
        background-color: #cce5ff;
        color: #004085;
    }

    .badge-status-3 {
        background-color: #d4edda;
        color: #155724;
    }

    .btn-emerald-outline {
        border: 2px solid #198754;
        color: #198754;
        background: transparent;
        font-weight: bold;
    }

        .btn-emerald-outline:hover {
            background-color: #198754;
            color: white;
        }

    .sticky-sidebar {
        position: sticky;
        top: 24px;
        z-index: 10;
    }

    .my-assigned-row {
        background-color: #f0fdf4 !important; /* Highlight lịch phân công cho mình */
    }

    /* Tag đánh dấu Today / Tomorrow */
    .schedule-tag-today {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #a3cfbb;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .schedule-tag-tomorrow {
        background-color: #cff4fc;
        color: #055160;
        border: 1px solid #9eeaf9;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
</style>

<div class="admin-console-wrapper py-5">
    <div class="container">

        <!-- ALERT THÔNG BÁO TỪ TEMP DATA -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 small mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- HEADER CONSOLE -->
        <div class="mb-4">
            <h3 class="fw-bold text-dark m-0"><i class="fas fa-layer-group text-success me-2"></i>Appointments Management</h3>
            <p class="text-muted small m-0">Monitor workspace operations, patient tracking, and shift workflows.</p>
        </div>

        <div class="row g-4">
            <!-- CỘT TRÁI: TABLE DANH SÁCH CHÍNH -->
            <div class="col-lg-9">
                <div class="bg-white rounded-4 shadow-sm p-4 border-0">

                    <!-- THANH CÔNG CỤ LỌC PHÍA TRÊN TABLE -->
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <!-- TỪ KHÓA TÌM KIẾM -->
                        <div class="flex-grow-1" style="min-width: 240px;">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" id="consoleSearchInput" class="form-control rounded-end-3 bg-light border-0 small" placeholder="Search Pet or Doctor...">
                            </div>
                        </div>

                        <!-- LỌC THEO BÁC SĨ (VET FILTER) -->
                        <div style="min-width: 180px;">
                            <select id="doctorSelectFilter" class="form-select bg-light border-0 small rounded-3">
                                <option value="all">-- All Doctors --</option>
                                @foreach (var vet in doctorList)
                                {
                                    <option value="@vet.ToLower()">Dr. @vet</option>
                                }
                            </select>
                        </div>

                        <!-- LỌC THEO NGÀY -->
                        <div style="min-width: 160px;">
                            <input type="date" id="dateInputFilter" class="form-control bg-light border-0 small rounded-3" title="Filter by Schedule Date" />
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover border-top" id="appointmentsTable">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th>Patient Name</th>
                                    <th>Assigned Doctor</th>
                                    <th>Schedule Date</th>
                                    <th>Total Cost</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var app in Model)
                                    {
                                        bool isMyAssignment = (currentStaffId != Guid.Empty && app.StaffId == currentStaffId);
                                        var appDate = app.AppointmentStart.Date;
                                        bool isToday = (appDate == today);
                                        bool isTomorrow = (appDate == tomorrow);

                                        string statusText = app.Status switch
                                        {
                                            0 => "Cancelled / Expired",
                                            1 => "Reserved / Pending Payment",
                                            2 => "Confirmed / Paid",
                                            3 => "Completed",
                                            _ => "Unknown"
                                        };

                                        <tr class="appointment-row @(isMyAssignment ? "my-assigned-row" : "")"
                                            data-status="@app.Status"
                                            data-staff-id="@app.StaffId.ToString()"
                                            data-vet="@(app.VetName?.ToLower() ?? "")"
                                            data-date="@app.AppointmentStart.ToString("yyyy-MM-dd")"
                                            data-price="@app.Total"
                                            data-search="@app.PetName.ToLower() @(app.VetName?.ToLower() ?? "")">

                                            <td class="fw-bold text-dark fs-6">
                                                @app.PetName
                                                @if (isMyAssignment)
                                                {
                                                    <span class="badge bg-success text-white small d-block mt-1" style="width: fit-content; font-size: 0.65rem;">
                                                        <i class="fas fa-user-tag me-1"></i>You
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-secondary">
                                                <i class="fas fa-user-md text-success me-1"></i>Dr. @(app.VetName ?? "Unassigned")
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-dark">@app.AppointmentStart.ToString("dd/MM/yyyy")</span>
                                                    @if (isToday)
                                                    {
                                                        <span class="badge schedule-tag-today rounded-pill px-2 py-1">
                                                            <i class="fas fa-bolt me-1"></i>TODAY
                                                        </span>
                                                    }
                                                    else if (isTomorrow)
                                                    {
                                                        <span class="badge schedule-tag-tomorrow rounded-pill px-2 py-1">
                                                            <i class="far fa-clock me-1"></i>TOMORROW
                                                        </span>
                                                    }
                                                </div>
                                                <div class="text-muted small">@app.AppointmentStart.ToString("HH:mm") - @app.AppointmentEnd.ToString("HH:mm")</div>
                                            </td>
                                            <td class="fw-bold text-success">
                                                @app.Total.ToString("N0") đ
                                            </td>
                                            <td>
                                                <span class="status-badge badge-status-@app.Status">State @app.Status: @statusText</span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="StaffAppointmentDetail" asp-route-id="@app.AppointmentId" class="btn btn-emerald-outline btn-sm py-1 px-3 rounded-2">
                                                    Open Track <i class="fas fa-folder-open ms-1"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="emptyRow">
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="fas fa-folder-open d-block fs-3 mb-2"></i> No records available.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: SIDEBAR BỘ LỌC TRẠNG THÁI & KHOẢNG GIÁ -->
            <div class="col-lg-3">
                <div class="bg-white rounded-4 shadow-sm p-4 sticky-sidebar border-0">
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <h5 class="fw-bold text-dark m-0"><i class="fas fa-filter text-success me-2"></i>Quick Filters</h5>
                        <button type="button" id="btnResetFilters" class="btn btn-link text-decoration-none text-muted p-0 small">
                            <i class="fas fa-undo me-1"></i>Reset
                        </button>
                    </div>

                    <!-- WORKFLOW STATUS & ASSIGNMENT -->
                    <label class="text-muted small fw-bold mb-2">Workflow Status</label>
                    <div class="d-flex flex-column gap-2 mb-4" id="filterButtonGroup">
                        <button class="btn btn-light text-start fw-bold text-dark p-3 rounded-3 active border-start border-success border-4" data-target-status="all">
                            <i class="fas fa-list me-2 text-secondary"></i> All Tracks
                        </button>
                        <button class="btn btn-light text-start fw-bold text-success p-3 rounded-3" data-target-staff="@currentStaffId.ToString()">
                            <i class="fas fa-user-check me-2"></i> My Assigned Tracks
                        </button>
                        <hr class="my-1 text-muted" />
                        <button class="btn btn-light text-start fw-bold text-warning p-3 rounded-3" data-target-status="1">
                            <i class="far fa-clock me-2"></i> 1: Reserved / Pending
                        </button>
                        <button class="btn btn-light text-start fw-bold text-primary p-3 rounded-3" data-target-status="2">
                            <i class="fas fa-check-circle me-2"></i> 2: Confirmed / Paid
                        </button>
                        <button class="btn btn-light text-start fw-bold text-success p-3 rounded-3" data-target-status="3">
                            <i class="fas fa-check-double me-2"></i> 3: Completed
                        </button>
                        <button class="btn btn-light text-start fw-bold text-danger p-3 rounded-3" data-target-status="0">
                            <i class="fas fa-times-circle me-2"></i> 0: Cancelled / Expired
                        </button>
                    </div>

                    <!-- LỌC THEO KHOẢNG GIÁ (PRICE RANGE) -->
                    <div>
                        <label class="text-muted small fw-bold mb-2">Total Amount Range</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" id="minPriceInput" class="form-control form-control-sm bg-light border-0 rounded-2" placeholder="Min (đ)">
                            </div>
                            <div class="col-6">
                                <input type="number" id="maxPriceInput" class="form-control form-control-sm bg-light border-0 rounded-2" placeholder="Max (đ)">
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const filterButtons = document.querySelectorAll("#filterButtonGroup button");
        const searchInput = document.getElementById("consoleSearchInput");
        const doctorSelectFilter = document.getElementById("doctorSelectFilter");
        const dateInputFilter = document.getElementById("dateInputFilter");
        const minPriceInput = document.getElementById("minPriceInput");
        const maxPriceInput = document.getElementById("maxPriceInput");
        const btnResetFilters = document.getElementById("btnResetFilters");

        const rows = document.querySelectorAll(".appointment-row");

        function filterTable() {
            const activeBtn = document.querySelector("#filterButtonGroup button.active");
            const targetStatus = activeBtn ? activeBtn.getAttribute("data-target-status") : "all";
            const targetStaff = activeBtn ? activeBtn.getAttribute("data-target-staff") : null;

            const selectedDoctor = doctorSelectFilter.value;
            const selectedDate = dateInputFilter.value;
            const query = searchInput.value.toLowerCase().trim();

            const minPrice = parseFloat(minPriceInput.value) || 0;
            const maxPrice = parseFloat(maxPriceInput.value) || Infinity;

            rows.forEach(row => {
                const status = row.getAttribute("data-status");
                const staffId = row.getAttribute("data-staff-id");
                const vet = row.getAttribute("data-vet");
                const rowDate = row.getAttribute("data-date");
                const price = parseFloat(row.getAttribute("data-price")) || 0;
                const searchContent = row.getAttribute("data-search");

                // 1. Kiểm tra Status
                let matchesStatus = true;
                if (targetStatus && targetStatus !== "all") {
                    matchesStatus = (status === targetStatus);
                }

                // 2. Kiểm tra Staff Assignment (My Assigned Tracks)
                let matchesStaff = true;
                if (targetStaff) {
                    matchesStaff = (staffId === targetStaff);
                }

                // 3. Kiểm tra Doctor Select
                let matchesDoctor = (selectedDoctor === "all") || (vet === selectedDoctor);

                // 4. Kiểm tra Ngày hẹn
                let matchesDate = !selectedDate || (rowDate === selectedDate);

                // 5. Kiểm tra Giá thành
                let matchesPrice = (price >= minPrice) && (price <= maxPrice);

                // 6. Kiểm tra Từ khóa
                let matchesSearch = !query || searchContent.includes(query);

                if (matchesStatus && matchesStaff && matchesDoctor && matchesDate && matchesPrice && matchesSearch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        // Sự kiện click Button Group bên Sidebar
        filterButtons.forEach(btn => {
            btn.addEventListener("click", function() {
                filterButtons.forEach(b => b.classList.remove("active", "border-start", "border-success", "border-4"));
                this.classList.add("active", "border-start", "border-success", "border-4");
                filterTable();
            });
        });

        // Nút Reset tất cả bộ lọc
        btnResetFilters.addEventListener("click", function() {
            searchInput.value = "";
            doctorSelectFilter.value = "all";
            dateInputFilter.value = "";
            minPriceInput.value = "";
            maxPriceInput.value = "";

            filterButtons.forEach(b => b.classList.remove("active", "border-start", "border-success", "border-4"));
            filterButtons[0].classList.add("active", "border-start", "border-success", "border-4");

            filterTable();
        });

        // Lắng nghe thay đổi trên các ô Input
        searchInput.addEventListener("input", filterTable);
        doctorSelectFilter.addEventListener("change", filterTable);
        dateInputFilter.addEventListener("change", filterTable);
        minPriceInput.addEventListener("input", filterTable);
        maxPriceInput.addEventListener("input", filterTable);
    });
</script>