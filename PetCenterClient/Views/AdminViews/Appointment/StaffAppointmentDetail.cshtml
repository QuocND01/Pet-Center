@model PetCenterClient.ViewModels.Appointment.AppointmentDetailViewModel
@{
    ViewData["Title"] = "Operation Track Detail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Standardized 4-State Mapping
    string statusText = Model.Status switch
    {
        0 => "Cancelled / Expired",
        1 => "Reserved / Pending Payment",
        2 => "Confirmed / Paid",
        3 => "Completed",
        _ => "Unknown"
    };

    // Fallback Image Utilities
    string defaultPetImg = "https://cdn-icons-png.flaticon.com/512/616/616408.png";
    string defaultVetImg = "https://cdn-icons-png.flaticon.com/512/387/387561.png";

    string petAvatarUrl = string.IsNullOrWhiteSpace(Model.PetAvatar) ? defaultPetImg : Model.PetAvatar;
    string vetAvatarUrl = string.IsNullOrWhiteSpace(Model.VetAvatar) ? defaultVetImg : Model.VetAvatar;
    string assignedVetName = !string.IsNullOrWhiteSpace(Model.VetName) ? Model.VetName : (Model.Snapshot?.VetName ?? "Not Assigned");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<style>
    .operation-wrapper {
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    .status-banner {
        border-left: 4px solid #198754;
        background: #ffffff;
    }

    .service-card-item {
        border-left: 4px solid #198754;
        background: #fff;
        transition: all 0.2s;
    }

        .service-card-item.completed-state {
            border-left-color: #6c757d;
            opacity: 0.85;
            background: #fdfdfd;
        }

    .btn-emerald {
        background-color: #198754;
        color: white;
        border: none;
        font-weight: bold;
    }

        .btn-emerald:hover {
            background-color: #146c43;
            color: white;
        }

        .btn-emerald:disabled {
            background-color: #a3cfbb;
            color: white;
            cursor: not-allowed;
        }

    .status-indicator-box {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: bold;
        text-align: center;
    }

    .badge-status-0 {
        background-color: #f8d7da;
        color: #842029;
    }

    .badge-status-1 {
        background-color: #fff3cd;
        color: #664d03;
    }

    .badge-status-2 {
        background-color: #cff4fc;
        color: #055160;
    }

    .badge-status-3 {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .star-rating .fa-star {
        font-size: 1.1rem;
    }

    .avatar-pet {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #198754;
    }

    .avatar-vet {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #0d6efd;
    }
</style>

<div class="operation-wrapper py-5">
    <div class="container">

        <!-- MESSAGES -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 small mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- BACK TO OVERVIEW -->
        <div class="mb-3">
            <a asp-action="StaffAppointments" class="text-success fw-bold text-decoration-none small">
                <i class="fas fa-chevron-left me-1"></i> Return to Console
            </a>
        </div>

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN PATIENT, VET, LOGS DỊCH VỤ & RATING FEEDBACK -->
            <div class="col-lg-8">

                <!-- BANNER THÔNG TIN CHUNG -->
                <div class="status-banner p-4 rounded-4 shadow-sm mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@petAvatarUrl" alt="@Model.PetName" class="avatar-pet shadow-sm" onerror="this.src='@defaultPetImg';" />
                        <div>
                            <span class="text-muted text-uppercase small fw-bold tracking-wider">Active Operation Track</span>
                            <h2 class="fw-bold text-dark m-0">Patient: @Model.PetName</h2>
                            <p class="text-secondary small m-0 mt-1">
                                <i class="far fa-user me-1"></i><strong>Customer:</strong> @Model.CustomerName
                            </p>
                        </div>
                    </div>

                    <!-- CHI TIẾT THÔNG TIN PET TỪ SNAPSHOT -->
                    @if (Model.Snapshot != null)
                    {
                        <div class="row g-2 bg-light p-3 rounded-3 text-dark small mb-3 border">
                            <div class="col-6 col-md-3">
                                <i class="fas fa-paw text-success me-1"></i><strong>Species:</strong> @(string.IsNullOrWhiteSpace(Model.Snapshot.Species) ? "N/A" : Model.Snapshot.Species)
                            </div>
                            <div class="col-6 col-md-3">
                                <i class="fas fa-dna text-success me-1"></i><strong>Breed:</strong> @(string.IsNullOrWhiteSpace(Model.Snapshot.Breed) ? "N/A" : Model.Snapshot.Breed)
                            </div>
                            <div class="col-6 col-md-3">
                                <i class="fas fa-venus-mars text-success me-1"></i><strong>Gender:</strong> @(string.IsNullOrWhiteSpace(Model.Snapshot.Gender) ? "N/A" : Model.Snapshot.Gender)
                            </div>
                            <div class="col-6 col-md-3">
                                <i class="fas fa-weight-hanging text-success me-1"></i><strong>Weight:</strong> @Model.Snapshot.Weight kg
                            </div>
                        </div>
                    }

                    <!-- THÔNG TIN VET PHỤ TRÁCH -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-success-subtle rounded-3 border border-success-subtle">
                        <img src="@vetAvatarUrl" alt="@assignedVetName" class="avatar-vet shadow-sm" onerror="this.src='@defaultVetImg';" />
                        <div>
                            <span class="text-muted small d-block">Assigned Veterinarian</span>
                            <strong class="text-dark"><i class="fas fa-user-md text-success me-1"></i>Dr. @assignedVetName</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 text-secondary small">
                            <i class="far fa-comment-dots text-success me-1"></i> <strong>Medical Note:</strong> "@Model.Note"
                        </div>
                    }
                </div>

                <!-- CHI TIẾT CÁC HẠNG MỤC DỊCH VỤ CỦA LỊCH HẸN -->
                <div class="bg-white rounded-4 shadow-sm p-4 border-0 mb-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="fas fa-notes-medical text-success me-2"></i>Treatment Log / Services</h5>

                    <div class="d-flex flex-column gap-3">
                        @if (Model.AppointmentServices != null && Model.AppointmentServices.Any())
                        {
                            foreach (var srv in Model.AppointmentServices)
                            {
                                bool isSrvDone = srv.CompleteAt.HasValue;

                                <div class="p-3 rounded-3 border service-card-item @(isSrvDone ? "completed-state" : "") shadow-sm d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold text-dark m-0">@srv.ServiceName</h6>
                                            <span class="badge bg-secondary-subtle text-secondary border small">Type @srv.ServiceType</span>
                                        </div>
                                        <span class="text-muted small">@srv.Price.ToString("N0") đ • <i class="far fa-clock me-1"></i>@srv.Duration min</span>
                                    </div>
                                    <div>
                                        @if (isSrvDone)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                                                <i class="fas fa-check-circle me-1"></i>
                                                Done at: @srv.CompleteAt.Value.ToString("HH:mm dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            if (Model.Status == 3)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                                                    <i class="fas fa-check-circle me-1"></i>Completed
                                                </span>
                                            }
                                            else if (Model.Status == 2)
                                            {
                                                <!-- ĐÃ GẮN CLASS form-pending-service ĐỂ TỰ ĐỘNG TRIGGER KHI COMPLETE APPOINTMENT -->
                                                <form asp-action="CompleteAppointmentService" method="post" class="d-inline form-pending-service">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                                                    <input type="hidden" name="appointmentServiceId" value="@srv.AppointmentServiceId" />
                                                    <button type="submit" class="btn btn-emerald btn-sm rounded-2 px-3">
                                                        <i class="fas fa-check me-1"></i> Mark Done
                                                    </button>
                                                </form>
                                            }
                                            else if (Model.Status == 1)
                                            {
                                                <span class="text-warning small fw-bold"><i class="fas fa-hourglass-half me-1"></i> Awaiting Payment (State 1)</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger small fw-bold"><i class="fas fa-times-circle me-1"></i> Cancelled</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- KHỐI HIỂN THỊ ĐÁNH GIÁ VÀ PHẢN HỒI -->
                <div class="bg-white rounded-4 shadow-sm p-4 border-0">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fas fa-star text-warning me-2"></i>Customer Rating &amp; Feedback
                    </h5>

                    @if (Model.Snapshot != null && (Model.Snapshot.Rating > 0 || !string.IsNullOrWhiteSpace(Model.Snapshot.Feedback)))
                    {
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center mb-2">
                                <span class="fw-bold me-2 text-dark">Rating:</span>
                                <div class="star-rating text-warning me-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Floor(Model.Snapshot.Rating))
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        else if (i - Model.Snapshot.Rating <= 0.5m)
                                        {
                                            <i class="fas fa-star-half-alt"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-muted"></i>
                                        }
                                    }
                                </div>
                                <span class="badge bg-warning text-dark fw-bold">@Model.Snapshot.Rating / 5.0</span>
                            </div>

                            <div class="mt-2">
                                <strong class="text-dark small d-block mb-1"><i class="far fa-comment-alt me-1"></i>Feedback:</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.Snapshot.Feedback))
                                {
                                    <p class="text-secondary small mb-0 fst-italic">"@Model.Snapshot.Feedback"</p>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No written review provided.</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted bg-light rounded-3 border">
                            <i class="far fa-smile-beam fs-3 mb-2 d-block text-secondary"></i>
                            <span class="small">No feedback or rating has been provided for this appointment yet.</span>
                        </div>
                    }
                </div>

            </div>

            <!-- CỘT PHẢI: BẢNG ĐIỀU KHIỂN TRẠNG THÁI -->
            <div class="col-lg-4">
                <div class="bg-white rounded-4 shadow-sm p-4 border-0 text-center sticky-top" style="top: 24px;">
                    <h5 class="fw-bold text-dark pb-2 mb-3 border-bottom text-start"><i class="fas fa-shield-alt text-success me-2"></i>Workflow Action</h5>

                    <!-- BOX HIỂN THỊ TRẠNG THÁI HIỆN TẠI -->
                    <div class="mb-4">
                        <label class="text-muted small d-block mb-1 text-start fw-bold">Current Pipeline State</label>
                        <div class="status-indicator-box badge-status-@Model.Status shadow-sm">
                            State @Model.Status: @statusText
                        </div>
                    </div>

                    <!-- THỜI GIAN LÀM VIỆC & BẢO HIỂM / TỔNG TIỀN -->
                    <div class="text-start p-3 bg-light rounded-3 mb-4 small">
                        <div class="mb-2"><strong><i class="far fa-calendar-alt text-success me-2"></i>Date:</strong> @Model.AppointmentStart.ToString("dd MMMM, yyyy")</div>
                        <div class="mb-2"><strong><i class="far fa-clock text-success me-2"></i>Time Window:</strong> @Model.AppointmentStart.ToString("HH:mm") - @Model.AppointmentEnd.ToString("HH:mm")</div>
                        <div class="pt-2 border-top"><strong><i class="fas fa-receipt text-success me-2"></i>Total Payment:</strong> <span class="fs-6 fw-bold text-success">@Model.Total.ToString("N0") đ</span></div>
                    </div>

                    <!-- FORM SUBMIT TIẾN TRÌNH TIẾP THEO -->
                    @if (Model.Status == 2)
                    {
                        <form asp-action="ForwardAppointment" method="post" id="forwardWorkflowForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

                            <button type="button" class="btn btn-emerald btn-lg w-100 shadow rounded-3 py-3" onclick="confirmWorkflowTransition()">
                                COMPLETE APPOINTMENT <i class="fas fa-check-circle ms-2"></i>
                            </button>
                        </form>
                    }
                    else if (Model.Status == 1)
                    {
                        <div class="alert alert-warning small mb-0 text-start">
                            <i class="fas fa-exclamation-triangle me-1"></i> Awaiting customer payment before proceeding.
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100 rounded-3 py-3" disabled>
                            <i class="fas fa-lock me-2"></i> Terminal Track State
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL CONFIRMATION -->
<div class="modal fade" id="confirmForwardModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body p-4 text-center">
                <i class="fas fa-check-circle text-success fs-1 mb-3"></i>
                <h5 class="fw-bold text-dark">Complete Appointment?</h5>
                <p class="text-muted small">Are you sure you want to mark all remaining services as done and complete this appointment?</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-light btn-sm px-3 rounded-3 fw-bold" data-bs-dismiss="modal" id="btnModalAbort">Abort</button>
                    <button type="button" class="btn btn-emerald btn-sm px-3 rounded-3 fw-bold" id="btnModalConfirmSubmit">Execute</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const workflowModal = new bootstrap.Modal(document.getElementById('confirmForwardModal'));

    function confirmWorkflowTransition() {
        workflowModal.show();
    }

    document.getElementById('btnModalConfirmSubmit').addEventListener('click', async function() {
        const btnConfirm = this;
        const btnAbort = document.getElementById('btnModalAbort');

        // Khóa các nút và hiển thị trạng thái loading
        btnConfirm.disabled = true;
        btnAbort.disabled = true;
        btnConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...';

        try {
            // Lấy tất cả các form của những dịch vụ chưa được Done
            const pendingForms = document.querySelectorAll('.form-pending-service');

            if (pendingForms.length > 0) {
                // Tạo mảng promise gọi song song API hoàn thành từng dịch vụ
                const requestPromises = Array.from(pendingForms).map(form => {
                    const formData = new FormData(form);
                    return fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });
                });

                // Đợi tất cả request CompleteAppointmentService hoàn tất
                await Promise.all(requestPromises);
            }

            // Gửi form Complete Appointment
            document.getElementById('forwardWorkflowForm').submit();
        } catch (error) {
            console.error('Error during auto-complete services:', error);
            alert('An error occurred while marking services as completed. Please check your connection and try again.');
            btnConfirm.disabled = false;
            btnAbort.disabled = false;
            btnConfirm.innerHTML = 'Execute';
        }
    });
</script>