@using PetCenterClient.ViewModels.Inventory
@model InventoryDetailViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/AdminViews/ManageInventory/inventory_detail.css" asp-append-version="true" />

<style>
    /* 1. ĐỊNH DẠNG BẢNG VÀ CHỐNG TRÀN CHỮ TRUYỀN THỐNG SẠCH SẼ */
    .data-table {
        table-layout: fixed;
        width: 100%;
    }

        .data-table th,
        .data-table td {
            vertical-align: middle;
        }

    /* Đảm bảo Badge Status hiển thị trọn vẹn, không bao giờ bị cắt thành ... */
    .badge-status,
    .txn-type-badge {
        white-space: nowrap !important;
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Class hỗ trợ rút gọn text 1 dòng bằng dấu (...) */
    .text-ellipsis {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
        width: 100%;
    }

    /* Xử lý riêng cho ô Note: Không bị gãy dòng, cắt đẹp bằng (...) */
    .note-cell {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }

    /* Chống vỡ layout cho Header Card */
    .product-content h2,
    .product-meta span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
        display: block;
    }
</style>

<div class="page-wrapper">

    <div class="page-header">
        <div class="page-title-group">
            <h1>Inventory Detail</h1>
            <p>Monitor inventory status and batches.</p>
        </div>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <!-- Product Info Card -->
    <div class="product-card">
        <img src="@Model.ProductImage" class="product-image" alt="@Model.ProductName" />
        <div class="product-content" style="min-width: 0;">
            <h2 title="@Model.ProductName">@Model.ProductName</h2>
            <div class="product-meta">
                <span title="SKU: @Model.SKU">SKU : @Model.SKU</span>
                <span title="Brand: @Model.Brand">Brand : @Model.Brand</span>
                <span title="Category: @Model.Category">Category : @Model.Category</span>
            </div>
            <div class="last-update">
                Last Updated : @Model.LastUpdated.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

    <div class="summary-grid">
        <div class="summary-card success">
            <span>Available</span>
            <strong>@Model.QuantityAvailable</strong>
        </div>
        <div class="summary-card warning">
            <span>Reserved</span>
            <strong>@Model.QuantityReserved</strong>
        </div>
    </div>

    <!-- Batch Information Card -->
    <div class="table-card">
        <div class="table-header">
            <h3>
                <i class="bi bi-box-seam"></i>
                Batch Information
            </h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 22%;">Batch</th>
                    <th style="width: 14%;">MFG</th>
                    <th style="width: 14%;">EXP</th>
                    <th style="width: 11%;">Imported</th>
                    <th style="width: 10%;">Sold</th>
                    <th style="width: 13%;">Stock Left</th>
                    <th style="width: 16%;">Status</th> <!-- Tăng độ rộng lên 16% để không bị (...) -->
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in Model.Batches)
                {
                    <tr>
                        <td>
                            <span class="batch-code text-ellipsis" title="@batch.BatchCode">
                                <i class="bi bi-qr-code me-1"></i>@batch.BatchCode
                            </span>
                        </td>
                        <td>@(batch.ManufacturingDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(batch.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td><span class="num-imported">@batch.Quantity</span></td>
                        <td><span class="num-sold">@batch.QuantitySold</span></td>
                        <td><strong class="num-left">@batch.StockLeft</strong></td>
                        <td>
                            @{
                                var css = batch.BatchStatus switch
                                {
                                    BatchStatus.Active => "badge-active",
                                    BatchStatus.Expired => "badge-danger",
                                    BatchStatus.Pending => "badge-warning",
                                    BatchStatus.Exhausted => "badge-secondary",
                                    _ => "badge-secondary"
                                };
                            }
                            <span class="badge-status @css">
                                @batch.BatchStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Inventory Transactions Card -->
    <div class="table-card">
        <div class="table-header">
            <h3>
                <i class="bi bi-clock-history"></i>
                Inventory Transactions
            </h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 22%;">Date</th>
                    <th style="width: 16%;">Type</th>
                    <th style="width: 12%;">Change</th>
                    <th style="width: 10%;">Before</th>
                    <th style="width: 10%;">After</th>
                    <th style="width: 30%;">Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    var isPositive = t.QuantityChange > 0;
                    var isNegative = t.QuantityChange < 0;

                    var changeCss = isPositive ? "change-plus" : (isNegative ? "change-minus" : "change-zero");
                    var changeSign = isPositive ? "+" : "";

                    var typeCss = t.TransactionType.ToString().ToLower() switch
                    {
                        var type when type.Contains("import") || type.Contains("in") => "txn-in",
                        var type when type.Contains("export") || type.Contains("out") || type.Contains("sale") => "txn-out",
                        var type when type.Contains("adjust") => "txn-adjust",
                        _ => "txn-default"
                    };

                    <tr>
                        <td class="text-nowrap">
                            <i class="bi bi-calendar3 me-1 text-muted"></i>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <span class="txn-type-badge @typeCss">
                                @t.TransactionType
                            </span>
                        </td>
                        <td>
                            <span class="change-badge @changeCss">
                                @changeSign@t.QuantityChange
                            </span>
                        </td>
                        <td class="text-muted">@t.QuantityBefore</td>
                        <td><strong>@t.QuantityAfter</strong></td>
                        <td class="note-cell" title="@t.Note">
                            @(string.IsNullOrWhiteSpace(t.Note) ? "-" : t.Note)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>