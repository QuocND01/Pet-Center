@using PetCenterClient.ViewModels.Supplier
@model CreateSupplierViewModel
@{
    Layout = null;

    // Xử lý định dạng TaxId trước khi render lên input
    string formattedTaxId = string.Empty;
    if (!string.IsNullOrWhiteSpace(Model?.TaxId))
    {
        // 1. Loại bỏ các ký tự không phải số
        string rawDigits = new string(Model.TaxId.Where(char.IsDigit).ToArray());

        // 2. Nếu đủ 13 số -> Định dạng lại thành 10 số - 3 số
        if (rawDigits.Length == 13)
        {
            formattedTaxId = $"{rawDigits.Substring(0, 10)}-{rawDigits.Substring(10, 3)}";
        }
        // 3. Nếu là 10 số hoặc các trường hợp khác -> Lấy nguyên chuỗi số (tối đa 10 số nếu lớn hơn)
        else if (rawDigits.Length >= 10)
        {
            formattedTaxId = rawDigits.Substring(0, Math.Min(rawDigits.Length, 10));
        }
        else
        {
            formattedTaxId = rawDigits;
        }
    }
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/AdminViews/ManageSupplier/edit_supplier.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<form id="editForm" class="custom-form-modal">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SupplierId" />

    <div asp-validation-summary="All" class="alert alert-danger-custom" style="display:none;"></div>

    <div class="form-grid">
        <div class="form-group mb-3">
            <label class="form-label-custom" asp-for="TaxId">Tax ID</label>
            <!-- Sử dụng value="@formattedTaxId" để gán giá trị đã được định dạng -->
            <input class="form-input-custom" asp-for="TaxId" value="@formattedTaxId" placeholder="e.g. 0101234567 or 0101234567-001" maxlength="14" />
            <span asp-validation-for="TaxId" class="validation-message"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label-custom" asp-for="SupplierName">Supplier Name</label>
            <input class="form-input-custom" asp-for="SupplierName" placeholder="Enter name..." />
            <span asp-validation-for="SupplierName" class="validation-message"></span>
        </div>

        <div class="form-row">
            <div class="form-group mb-3 flex-1">
                <label class="form-label-custom" asp-for="SupplierEmail">Email Address</label>
                <input class="form-input-custom" asp-for="SupplierEmail" type="email" placeholder="example@gmail.com" />
                <span asp-validation-for="SupplierEmail" class="validation-message"></span>
            </div>
            <div class="form-group mb-3 flex-1">
                <label class="form-label-custom" asp-for="SupplierPhoneNumber">Phone Number</label>
                <input class="form-input-custom" asp-for="SupplierPhoneNumber" placeholder="090..." />
                <span asp-validation-for="SupplierPhoneNumber" class="validation-message"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label class="form-label-custom" asp-for="SupplierAddress">Office Address</label>
            <input class="form-input-custom" asp-for="SupplierAddress" placeholder="Street, City..." />
            <span asp-validation-for="SupplierAddress" class="validation-message"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label-custom" asp-for="ContactPerson">Contact Person</label>
            <input class="form-input-custom" asp-for="ContactPerson" placeholder="Full name of representative" />
            <span asp-validation-for="ContactPerson" class="validation-message"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label-custom" asp-for="SupplierDescription">Description</label>
            <textarea class="form-input-custom" asp-for="SupplierDescription" rows="3" placeholder="Additional notes..."></textarea>
            <span asp-validation-for="SupplierDescription" class="validation-message"></span>
        </div>
    </div>

    <div class="modal-actions-footer">
        <button type="button" class="btn-cancel-modal" data-bs-dismiss="modal">Discard</button>
        <button type="submit" class="btn-submit-modal">
            <i class="bi bi-check2-circle"></i> Save Changes
        </button>
    </div>
</form>

<script>
    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: "toast-top-right",
        timeOut: "3000"
    };
</script>