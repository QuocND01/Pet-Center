@model PetCenterClient.ViewModels.Register.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg,#2ecc71,#27ae60);
            font-family: Segoe UI, system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 24px 15px;
            overflow-y: auto;
        }

        .register-card {
            width: 100%;
            max-width: 480px;
            background: white;
            padding: 36px 40px;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            box-sizing: border-box;
        }

        .field-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #34495e;
            margin-bottom: 6px;
            text-align: left;
        }

        .title {
            font-size: 28px;
            font-weight: 700;
            text-align: center;
            color: #2ecc71;
            margin-bottom: 24px;
        }

        .form-control {
            height: 45px;
            border-radius: 10px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.15);
            background-image: none !important;
        }

        .form-control.is-valid {
            border-color: #198754;
            box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.15);
            background-image: none !important;
        }

        /* Hide Edge / IE native password reveal icon so only 1 custom eye icon is shown */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        .position-relative .form-control {
            padding-right: 42px !important;
        }

        .field-feedback {
            font-size: 12.5px;
            margin-top: 5px;
            display: none;
            line-height: 1.4;
            text-align: left;
        }

        .field-feedback.feedback-error {
            color: #dc3545;
            display: block;
        }

        .field-feedback.feedback-success {
            color: #198754;
            display: block;
        }

        .btn-register {
            height: 45px;
            border-radius: 10px;
            background: #2ecc71;
            border: none;
            font-weight: 600;
            color: white;
            margin-top: 8px;
        }

            .btn-register:hover {
                background: #27ae60;
            }

        .logo {
            font-size: 40px;
            text-align: center;
            margin-bottom: 8px;
        }

        .error {
            color: #dc3545;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13.5px;
            text-align: center;
            margin-bottom: 18px;
            word-break: break-word;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="logo">🐶</div>
        <div class="title">Create Account</div>
        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }
        <form method="post" id="registerForm">
            <div class="mb-3">
                <label for="fullName" class="field-label">Full Name</label>
                <input id="fullName" name="FullName" maxlength="50" class="form-control" placeholder="e.g. John Doe" required />
                <div id="fullNameMsg" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="email" class="field-label">Email Address</label>
                <input type="email" id="email" name="Email" maxlength="50" class="form-control" placeholder="e.g. john@example.com" required />
                <div id="emailMsg" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="phoneNumber" class="field-label">Phone Number</label>
                <input id="phoneNumber" name="PhoneNumber" pattern="[0-9]{10}"
                       class="form-control" placeholder="e.g. 0912345678" required />
                <div id="phoneMsg" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="password" class="field-label">Password</label>
                <div class="position-relative">
                    <input type="password" id="password" name="Password" class="form-control pe-5" placeholder="At least 6 chars (e.g. Abc@123)" required />
                    <button type="button" class="btn border-0 position-absolute end-0 top-50 translate-middle-y me-2 text-muted shadow-none"
                            onclick="togglePasswordVisibility('password', this)" tabindex="-1" style="z-index: 10;">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div id="passwordStrength" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="field-label">Confirm Password</label>
                <input type="password" id="confirmPassword" class="form-control" placeholder="Re-enter your password" required />
                <div id="passwordMatch" class="field-feedback"></div>
                <div id="passwordMatchSuccess" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="birthDay" class="field-label">Date of Birth</label>
                <input type="date" id="birthDay" name="BirthDay" class="form-control" required />
                <div id="birthdayMsg" class="field-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="gender" class="field-label">Gender</label>
                <select id="gender" name="Gender" class="form-control" required>
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <div id="genderMsg" class="field-feedback"></div>
            </div>
            <button type="submit" class="btn btn-register w-100" id="registerBtn">Register</button>
        </form>
        <div class="text-center mt-3">
            Already have an account?
            <a href="/Auth/Login" style="color:#2ecc71;font-weight:600;">Login</a>
        </div>
        <div class="text-center mt-2" style="font-size:13px; color:#64748b;">
            Need help or account assistance?
            <a href="javascript:void(0)" onclick="openContactSupportModal()" style="color:#3b82f6; font-weight:600; text-decoration:none;">
                <i class="bi bi-headset me-1"></i>Contact Support
            </a>
        </div>
    </div>
    <script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector("i");
        if (input.type === "password") {
            input.type = "text";
            icon.className = "bi bi-eye-slash";
        } else {
            input.type = "password";
            icon.className = "bi bi-eye";
        }
    }

    const passwordInput        = document.getElementById("password");
    const confirmPassword      = document.getElementById("confirmPassword");
    const strength             = document.getElementById("passwordStrength");
    const passwordMatch        = document.getElementById("passwordMatch");
    const registerBtn          = document.getElementById("registerBtn");
    const registerForm         = document.getElementById("registerForm");

    const fullNameInput = document.getElementById("fullName");
    const fullNameMsg   = document.getElementById("fullNameMsg");

    const emailInput    = document.getElementById("email");
    const emailMsg      = document.getElementById("emailMsg");

    const phoneInput    = document.getElementById("phoneNumber");
    const phoneMsg      = document.getElementById("phoneMsg");

    const birthdayInput = document.getElementById("birthDay");
    const birthdayMsg   = document.getElementById("birthdayMsg");

    const genderInput   = document.getElementById("gender");
    const genderMsg     = document.getElementById("genderMsg");

    // ============================================================
    // HELPER: Show / Hide Feedback (Error messages only)
    // ============================================================
    function updateFeedback(msgEl, inputEl, errText) {
        if (errText) {
            msgEl.textContent = "❌ " + errText;
            msgEl.className = "field-feedback feedback-error";
            inputEl.classList.add("is-invalid");
        } else {
            msgEl.textContent = "";
            msgEl.className = "field-feedback";
            inputEl.classList.remove("is-invalid");
        }
    }

    // ============================================================
    // FULL NAME
    // ============================================================
    function validateFullName(val) {
        const trimmed = val.trim();
        if (!trimmed)                                  return "Full name is required";
        if (trimmed.length < 2)                        return "Full name must be at least 2 characters";
        if (trimmed.length > 50)                       return "Full name must not exceed 50 characters";
        if (!/^[a-zA-ZÀ-ỹ\s]+$/.test(trimmed))         return "Full name must contain letters only";
        if (trimmed.split(/\s+/).length < 2)           return "Please enter your full name (first and last name)";
        return "";
    }

    fullNameInput.addEventListener("input", function () {
        const err = validateFullName(this.value);
        updateFeedback(fullNameMsg, fullNameInput, err);
    });

    // ============================================================
    // EMAIL
    // ============================================================
    function validateEmail(val) {
        const trimmed = val.trim();
        if (!trimmed)                                           return "Email is required";
        if (trimmed.length > 50)                                return "Email must not exceed 50 characters";
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(trimmed))       return "Invalid email format";
        return "";
    }

    emailInput.addEventListener("input", function () {
        const err = validateEmail(this.value);
        updateFeedback(emailMsg, emailInput, err);
    });

    // ============================================================
    // PHONE
    // ============================================================
    function validatePhone(val) {
        const trimmed = val.trim();
        if (!trimmed)                                                       return "Phone number is required";
        if (!/^\d+$/.test(trimmed))                                         return "Phone number must contain digits only";
        if (!/^0\d{9}$/.test(trimmed))                                      return "Phone number must start with 0 and be exactly 10 digits";
        if (!/^(03[2-9]|05[2689]|07[06-9]|08[1-9]|09[0-9])\d{7}$/.test(trimmed)) return "Invalid Vietnamese phone number (e.g. 0912345678)";
        return "";
    }

    phoneInput.addEventListener("input", function () {
        const err = validatePhone(this.value);
        updateFeedback(phoneMsg, phoneInput, err);
    });

    // ============================================================
    // BIRTHDAY (REQUIRED)
    // ============================================================
    const today      = new Date();
    const minAgeDate = new Date();
    minAgeDate.setFullYear(minAgeDate.getFullYear() - 16);
    const maxAgeDate = new Date();
    maxAgeDate.setFullYear(maxAgeDate.getFullYear() - 100);
    birthdayInput.max = today.toISOString().split("T")[0];

    function validateBirthday(val) {
        if (!val)               return "Date of birth is required";
        const birth = new Date(val);
        if (birth > today)      return "Birthday cannot be in the future";
        if (birth > minAgeDate) return "You must be at least 16 years old to register";
        if (birth < maxAgeDate) return "Date of birth cannot be more than 100 years ago";
        return "";
    }

    birthdayInput.addEventListener("change", function () {
        const err = validateBirthday(this.value);
        updateFeedback(birthdayMsg, birthdayInput, err);
    });
    birthdayInput.addEventListener("input", function () {
        const err = validateBirthday(this.value);
        updateFeedback(birthdayMsg, birthdayInput, err);
    });

    // ============================================================
    // PASSWORD
    // ============================================================
    function validatePassword(val) {
        const errors = [];
        if (val.length < 6)             errors.push("At least 6 characters");
        if (!/[A-Z]/.test(val[0]))      errors.push("First character must be uppercase");
        if (!/@@/.test(val))             errors.push("Must contain @@");
        if (!/[0-9]/.test(val))         errors.push("Must contain at least 1 number");
        if (/\s/.test(val))             errors.push("No spaces allowed");
        return errors;
    }

    function showStrength() {
        const val = passwordInput.value;
        if (!val) {
            updateFeedback(strength, passwordInput, "");
            return;
        }
        const errors = validatePassword(val);
        if (errors.length > 0) {
            updateFeedback(strength, passwordInput, errors.join(" | "));
        } else {
            updateFeedback(strength, passwordInput, "");
        }
        showMatch();
    }

    passwordInput.addEventListener("input", showStrength);

    // ============================================================
    // CONFIRM PASSWORD
    // ============================================================
    function showMatch() {
        const cpw = confirmPassword.value;
        if (!cpw) {
            passwordMatch.style.display = "none";
            confirmPassword.classList.remove("is-invalid");
            registerBtn.disabled = false;
            return;
        }
        const match = passwordInput.value === cpw;
        if (match) {
            passwordMatch.style.display = "none";
            confirmPassword.classList.remove("is-invalid");
            registerBtn.disabled = false;
        } else {
            passwordMatch.style.display = "block";
            passwordMatch.textContent   = "❌ Passwords do not match";
            confirmPassword.classList.add("is-invalid");
            registerBtn.disabled = true;
        }
    }

    confirmPassword.addEventListener("input", showMatch);

    // ============================================================
    // ERROR BANNER
    // ============================================================
    const errorDiv = document.querySelector(".error") || (() => {
        const d = document.createElement("div");
        d.className = "error";
        d.style.display = "none";
        registerForm.insertAdjacentElement("beforebegin", d);
        return d;
    })();

    function showError(msg) {
        errorDiv.textContent = msg;
        errorDiv.style.display = "block";
        errorDiv.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function hideError() {
        errorDiv.style.display = "none";
        errorDiv.textContent = "";
    }

    // ============================================================
    // SUBMIT — AJAX
    // ============================================================
    registerForm.addEventListener("submit", async function (e) {
        e.preventDefault();
        hideError();

        const fullName   = fullNameInput.value.trim();
        const email      = emailInput.value.trim();
        const phone      = phoneInput.value.trim();
        const password   = passwordInput.value;
        const confirm    = confirmPassword.value;
        const birthday   = birthdayInput.value;
        const gender     = genderInput.value;

        const allErrors = [];
        const nameErr = validateFullName(fullName);
        if (nameErr)   allErrors.push("Full Name: " + nameErr);

        const emailErr = validateEmail(email);
        if (emailErr)  allErrors.push("Email: " + emailErr);

        const phoneErr = validatePhone(phone);
        if (phoneErr)  allErrors.push("Phone: " + phoneErr);

        const bdErr = validateBirthday(birthday);
        if (bdErr)     allErrors.push("Birthday: " + bdErr);

        const passErrors = validatePassword(password);
        if (passErrors.length > 0) allErrors.push("Password: " + passErrors.join(", "));

        if (password !== confirm) allErrors.push("Passwords do not match");
        if (!gender)              allErrors.push("Please select a gender");

        if (allErrors.length > 0) {
            showError(allErrors.join(" | "));
            return;
        }

        registerBtn.disabled     = true;
        registerBtn.textContent  = "Registering...";

        try {
            const formData = new FormData(registerForm);
            const response = await fetch(registerForm.action || window.location.href, {
                method: "POST",
                headers: { "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || "" },
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                window.location.href = result.redirectUrl;
            } else {
                showError(result.message || "Registration failed. Please try again.");
                registerBtn.disabled    = false;
                registerBtn.textContent = "Register";
            }
        } catch (err) {
            showError("An error occurred. Please try again.");
            registerBtn.disabled    = false;
            registerBtn.textContent = "Register";
        }
    });
</script>
<partial name="_ContactSupportModal" />
</body>
</html>