@{
    ViewData["Title"] = "Payment Result";
    bool isSuccess = ViewBag.Success ?? false;
    string message = ViewBag.Message ?? "";
    Guid? appointmentId = ViewBag.AppointmentId;
    string myAppointmentsUrl = "https://localhost:7010/Appointment/MyAppointments";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="payment-return-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 text-center bg-white">

                    @if (isSuccess)
                    {
                        <!-- SUCCESS ICON -->
                        <div class="icon-circle icon-circle-success mx-auto mb-4 animate-scale">
                            <i class="fas fa-check-circle"></i>
                        </div>

                        <h3 class="fw-bold text-dark mb-2">Payment Successful!</h3>
                        <p class="text-muted small mb-4">@message</p>

                        <div class="p-3 rounded-3 bg-light-green-box border-green-dash mb-4 text-start small">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary fw-semibold"><i class="fas fa-info-circle text-success me-1"></i> Status:</span>
                                <span class="badge bg-success text-white px-3 py-1 rounded-pill">Confirmed & Paid</span>
                            </div>
                            @if (appointmentId.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-secondary fw-semibold"><i class="fas fa-hashtag text-success me-1"></i> Appointment ID:</span>
                                    <strong class="text-dark">@appointmentId.Value.ToString().ToUpper().Substring(0, 8)</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- FAILED ICON -->
                        <div class="icon-circle icon-circle-danger mx-auto mb-4 animate-scale">
                            <i class="fas fa-times-circle"></i>
                        </div>

                        <h3 class="fw-bold text-dark mb-2">Payment Failed</h3>
                        <p class="text-muted small mb-4">@message</p>

                        <div class="p-3 rounded-3 bg-light-danger-box border-danger-dash mb-4 text-start small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary fw-semibold"><i class="fas fa-exclamation-triangle text-danger me-1"></i> Status:</span>
                                <span class="badge bg-danger text-white px-3 py-1 rounded-pill">Payment Unsuccessful</span>
                            </div>
                        </div>
                    }

                    <!-- AUTO REDIRECT TIMER -->
                    <div class="alert alert-light border rounded-3 p-2 mb-4 text-muted xsmall-text">
                        <i class="fas fa-spinner fa-spin text-success me-2"></i>
                        Redirecting to <strong>My Appointments</strong> in <span id="countdown" class="fw-bold text-success fs-6">3</span> seconds...
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                        <a href="@myAppointmentsUrl" class="btn btn-modern-success font-weight-bold px-4 py-2 shadow-sm">
                            <i class="fas fa-calendar-alt me-2"></i>View My Appointments
                        </a>

                        @if (appointmentId.HasValue)
                        {
                            <a href="@Url.Action("Detail", "Appointment", new { id = appointmentId })" class="btn btn-outline-secondary font-weight-bold px-4 py-2 rounded-3">
                                <i class="fas fa-eye me-2"></i>Appointment Detail
                            </a>
                        }
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-green: #10b981;
        --primary-green-hover: #059669;
        --light-green-bg: #f0fdf4;
        --accent-light-green: #d1fae5;
        --dark-theme: #1f2937;
        --border-color: #e5e7eb;
        --white: #ffffff;
    }

    .payment-return-wrapper {
        background-color: #f9fafb;
        min-height: 80vh;
        display: flex;
        align-items: center;
    }

    .icon-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
    }

    .icon-circle-success {
        background-color: var(--light-green-bg);
        color: var(--primary-green);
    }

    .icon-circle-danger {
        background-color: #fef2f2;
        color: #ef4444;
    }

    .bg-light-green-box {
        background-color: var(--light-green-bg);
    }

    .border-green-dash {
        border: 1px dashed var(--primary-green);
    }

    .bg-light-danger-box {
        background-color: #fef2f2;
    }

    .border-danger-dash {
        border: 1px dashed #ef4444;
    }

    .btn-modern-success {
        background-color: var(--primary-green);
        color: var(--white);
        border: none;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-modern-success:hover {
            background-color: var(--primary-green-hover);
            color: var(--white);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }

    .xsmall-text {
        font-size: 13px;
    }

    .animate-scale {
        animation: scaleIn 0.4s ease-out forwards;
    }

    @Html.Raw("@") keyframes scaleIn {
        0% {
            transform: scale(0.5);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<script>
    // Countdown Timer Auto-Redirect
    let timeLeft = 10;
    const countdownEl = document.getElementById('countdown');
    const targetUrl = "@myAppointmentsUrl";

    const timer = setInterval(() => {
        timeLeft--;
        if (countdownEl) {
            countdownEl.textContent = timeLeft;
        }
        if (timeLeft <= 0) {
            clearInterval(timer);
            window.location.href = targetUrl;
        }
    }, 1000);
</script>