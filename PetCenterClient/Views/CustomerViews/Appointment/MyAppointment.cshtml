@model List<PetCenterClient.ViewModels.Appointment.AppointmentListViewModel>

@{
    ViewData["Title"] = "My Appointments";
    // Sắp xếp danh sách lịch hẹn mặc định từ mới nhất đến cũ nhất
    var sortedAppointments = Model?.OrderByDescending(a => a.AppointmentStart).ToList() ?? new List<PetCenterClient.ViewModels.Appointment.AppointmentListViewModel>();
    var pendingPayments = sortedAppointments.Where(a => a.Status == 1).ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="appointment-container py-4" data-bs-theme="light">
    <div class="container-fluid px-lg-4">
        <!-- PAGE HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h4 class="fw-bold text-dark m-0"><i class="fas fa-calendar-alt text-success me-2"></i>My Appointments</h4>
                <p class="text-muted small m-0 mt-1">Manage and track your pet's healthcare schedules and activities.</p>
            </div>
            <a asp-controller="Appointment"
               asp-action="Book"
               class="btn btn-modern-success shadow-sm btn-sm px-3 py-2">
                <i class="fas fa-plus me-1"></i>Book New Appointment
            </a>
        </div>

        <!-- BANNER NHẮC NHỞ THANH TOÁN (COMPACT) -->
        @if (pendingPayments.Any())
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-3 py-2 px-3 mb-3 d-flex align-items-center justify-content-between" style="background: #fff8e1; border-left: 4px solid #ffb300 !important;">
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fas fa-exclamation-circle text-warning fs-6"></i>
                    <span class="text-dark">
                        You have <strong>@pendingPayments.Count</strong> pending payment booking(s). Please complete your payment to confirm.
                    </span>
                </div>
                @if (pendingPayments.Count == 1)
                {
                    <a href="@Url.Action("Detail", "Appointment", new { id = pendingPayments.First().AppointmentId })" class="btn btn-warning text-dark fw-bold btn-sm px-3 py-1 rounded-2 shadow-sm text-nowrap" style="font-size: 11px;">
                        <i class="fas fa-credit-card me-1"></i> Pay Now
                    </a>
                }
            </div>
        }

        <!-- TEMP_DATA NOTIFICATIONS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 py-2 px-3 small" role="alert">
                <i class="fas fa-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 py-2 px-3 small" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- MODERN SEARCH & FILTER CONTROL BAR -->
        <div class="filter-control-card bg-white p-3 rounded-3 shadow-sm border mb-3">
            <div class="row align-items-center g-2">
                <!-- Date Picker Filter -->
                <div class="col-md-4 col-sm-6">
                    <label class="form-label xsmall-text fw-bold text-secondary mb-1">
                        <i class="fas fa-calendar-day me-1"></i>Filter by Date
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0 rounded-start-2" style="border-color: var(--border-color);">
                            <i class="far fa-calendar-alt text-muted"></i>
                        </span>
                        <input type="date" id="searchDateInput" class="form-control border-start-0 px-2 fw-semibold" style="border-color: var(--border-color);" />
                    </div>
                </div>

                <!-- Status Dropdown Filter -->
                <div class="col-md-4 col-sm-6">
                    <label class="form-label xsmall-text fw-bold text-secondary mb-1">
                        <i class="fas fa-filter me-1"></i>Filter by Status
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0 rounded-start-2" style="border-color: var(--border-color);">
                            <i class="fas fa-tasks text-muted"></i>
                        </span>
                        <select id="statusFilterSelect" class="form-select border-start-0 px-2 fw-semibold" style="border-color: var(--border-color);">
                            <option value="all">All Statuses</option>
                            <option value="1">Reserved (Pending)</option>
                            <option value="2">Confirmed</option>
                            <option value="3">Completed</option>
                            <option value="0">Cancelled</option>
                        </select>
                    </div>
                </div>

                <!-- Quick Action Buttons -->
                <div class="col-md-4 d-flex gap-2 align-items-end mt-md-3">
                    <button type="button" id="btnFilterToday" class="btn btn-filter-pill px-3 py-1 fw-bold active">
                        <i class="fas fa-clock me-1"></i>Today
                    </button>
                    <button type="button" id="btnFilterAll" class="btn btn-filter-pill px-3 py-1 fw-bold">
                        <i class="fas fa-globe me-1"></i>View All
                    </button>
                </div>
            </div>
        </div>

        <!-- APPOINTMENTS CONTAINER -->
        @if (!sortedAppointments.Any())
        {
            <div class="text-center py-5 bg-white rounded-3 shadow-sm border">
                <div class="mb-3">
                    <i class="fas fa-calendar-times text-muted" style="font-size: 3rem;"></i>
                </div>
                <h6 class="fw-bold text-dark">No appointments found</h6>
                <p class="text-muted small px-3">You haven't scheduled any visits yet.</p>
                <a asp-controller="Appointment"
                   asp-action="Book"
                   class="btn btn-modern-success btn-sm shadow-sm">
                    <i class="fas fa-plus me-1"></i>Book Now
                </a>
            </div>
        }
        else
        {
            <!-- Lưới Grid 4 cột đồng nhất, liền mạch từ trái sang phải -->
            <div id="gridAppointmentsContainer" class="row g-3">
                <!-- Thẻ lịch hẹn sẽ được kết xuất động vào đây -->
            </div>

            <!-- Vòng lặp chứa dữ liệu gốc ẩn (Raw Data Pool) -->
            <div id="rawAppointmentsPool" style="display: none !important;">
                @foreach (var apt in sortedAppointments)
                {
                    <div class="raw-appointment-item"
                         data-date-iso="@apt.AppointmentStart.ToString("yyyy-MM-dd")"
                         data-status="@apt.Status">

                        <div class="col-xl-3 col-lg-4 col-sm-6 d-flex">
                            <div class="appointment-card bg-white rounded-3 p-3 shadow-sm border d-flex flex-column w-100 position-relative">

                                <!-- Header thẻ: Tên Pet & Trạng thái -->
                                <div class="d-flex justify-content-between align-items-start gap-1 mb-2 pb-2 border-bottom">
                                    <div class="text-truncate">
                                        <span class="text-muted xsmall-text d-block"><i class="fas fa-paw text-success me-1"></i>Pet</span>
                                        <h6 class="fw-bold text-dark text-truncate mb-0 fs-6" title="@apt.PetName">@apt.PetName</h6>
                                    </div>
                                    <div class="flex-shrink-0">
                                        @switch (apt.Status)
                                        {
                                            case 1:
                                                <span class="badge badge-custom bg-warning-subtle text-warning"><i class="far fa-clock me-1"></i>Reserved</span>
                                                break;
                                            case 2:
                                                <span class="badge badge-custom bg-info-subtle text-info"><i class="fas fa-calendar-check me-1"></i>Confirmed</span>
                                                break;
                                            case 3:
                                                <span class="badge badge-custom bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>Completed</span>
                                                break;
                                            case 0:
                                                <span class="badge badge-custom bg-danger-subtle text-danger"><i class="fas fa-times-circle me-1"></i>Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge badge-custom bg-secondary-subtle text-secondary">Status (@apt.Status)</span>
                                                break;
                                        }
                                    </div>
                                </div>

                                <!-- Body thẻ: Tích hợp Ngày + Giờ trực tiếp -->
                                <div class="card-body-details flex-grow-1 mb-2">
                                    <div class="d-flex justify-content-between align-items-center py-1">
                                        <span class="text-muted xsmall-text">Schedule:</span>
                                        <span class="fw-bold text-dark xsmall-text bg-light px-2 py-1 rounded border">
                                            <i class="far fa-calendar-alt text-success me-1"></i>@apt.AppointmentStart.ToString("dd/MM/yyyy") • @apt.AppointmentStart.ToString("HH:mm")
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-1">
                                        <span class="text-muted xsmall-text">Doctor:</span>
                                        <span class="fw-semibold text-dark text-truncate ms-2 xsmall-text" title="Dr. @apt.VetName">
                                            <i class="fas fa-user-md text-muted me-1"></i>Dr. @apt.VetName
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-1 border-top mt-1 pt-1">
                                        <span class="text-muted xsmall-text">Total:</span>
                                        <span class="text-success fw-bold small">@apt.Total.ToString("N0") đ</span>
                                    </div>
                                </div>

                                <!-- Footer thẻ: Button Action -->
                                <div class="mt-auto">
                                    <a href="@Url.Action("Detail", "Appointment", new { id = apt.AppointmentId })" class="btn btn-outline-modern btn-sm w-100 fw-semibold py-1">
                                        Details <i class="fas fa-chevron-right ms-1" style="font-size: 10px;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- NO RESULTS MATCH SCREEN -->
        <div id="noResultsScreen" class="text-center py-5 bg-white rounded-3 shadow-sm border" style="display: none;">
            <div class="mb-3">
                <i class="fas fa-search-minus text-muted" style="font-size: 3rem;"></i>
            </div>
            <h6 class="fw-bold text-dark">No matching appointments</h6>
            <p class="text-muted small px-3">There are no scheduled visits matching your selected filters.</p>
            <button type="button" id="btnResetSearch" class="btn btn-modern-success btn-sm px-3 mt-1">Clear Filters & View All</button>
        </div>

    </div>
</div>

<style>
    :root {
        --primary-green: #10b981;
        --primary-green-hover: #059669;
        --light-green-bg: #f0fdf4;
        --accent-light-green: #d1fae5;
        --dark-theme: #1f2937;
        --text-muted: #6b7280;
        --border-color: #e5e7eb;
        --bg-main: #f9fafb;
        --white: #ffffff;
    }

    body {
        background-color: var(--bg-main);
    }

    .btn-modern-success {
        background-color: var(--primary-green);
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-modern-success:hover {
            background-color: var(--primary-green-hover);
            color: var(--white);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.15);
        }

    .appointment-card {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border-color: var(--border-color) !important;
    }

        .appointment-card:hover {
            transform: translateY(-3px);
            border-color: var(--primary-green) !important;
            box-shadow: 0 6px 16px -2px rgba(16, 185, 129, 0.12) !important;
        }

    .badge-custom {
        padding: 3px 8px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 10px;
    }

    .bg-warning-subtle {
        background-color: #fffbeb;
    }

    .bg-info-subtle {
        background-color: #f0f9ff;
    }

    .bg-primary-subtle {
        background-color: #eff6ff;
    }

    .bg-success-subtle {
        background-color: #f0fdf4;
    }

    .bg-danger-subtle {
        background-color: #fef2f2;
    }

    .btn-filter-pill {
        background-color: var(--white);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        font-size: 12px;
        transition: all 0.2s ease;
    }

        .btn-filter-pill:hover, .btn-filter-pill.active {
            background-color: var(--light-green-bg);
            border-color: var(--primary-green);
            color: var(--primary-green);
        }

    .btn-outline-modern {
        border: 1px solid var(--border-color);
        color: var(--dark-theme);
        border-radius: 6px;
        font-size: 12px;
        transition: all 0.2s ease;
    }

        .btn-outline-modern:hover {
            border-color: var(--primary-green);
            background-color: var(--light-green-bg);
            color: var(--primary-green);
        }

    .xsmall-text {
        font-size: 11px;
    }
</style>

<!-- CLIENT-SIDE FILTER SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchDateInput = document.getElementById("searchDateInput");
        const statusFilterSelect = document.getElementById("statusFilterSelect");
        const btnFilterToday = document.getElementById("btnFilterToday");
        const btnFilterAll = document.getElementById("btnFilterAll");
        const btnResetSearch = document.getElementById("btnResetSearch");
        const gridContainer = document.getElementById("gridAppointmentsContainer");
        const noResultsScreen = document.getElementById("noResultsScreen");

        let currentDateMode = 'today';
        const rawItems = Array.from(document.querySelectorAll(".raw-appointment-item"));

        const todayISOStr = new Date().toISOString().split('T')[0];

        // Đảm bảo cuộn lên đầu trang mượt mà khi load trang từ Chatbot
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Đọc tham số từ URL (ví dụ: ?filter=all hoặc ?filter=confirmed&status=2)
        const urlParams = new URLSearchParams(window.location.search);
        const filterParam = (urlParams.get('filter') || '').toLowerCase();
        const statusParam = (urlParams.get('status') || '').toLowerCase();

        if (filterParam === 'today') {
            currentDateMode = 'today';
            searchDateInput.value = todayISOStr;
        } else {
            currentDateMode = 'all';
            searchDateInput.value = ''; // Để TRỐNG ô ngày khi View All / Confirmed
        }

        if (statusParam === '2' || filterParam === 'confirmed' || statusParam === 'confirmed') {
            statusFilterSelect.value = '2';
        } else if (statusParam && ['0','1','2','3','all'].includes(statusParam)) {
            statusFilterSelect.value = statusParam;
        } else {
            statusFilterSelect.value = 'all';
        }

        function filterAndGroupAppointments() {
            if (!gridContainer) return;

            // Xóa sạch grid hiện tại
            gridContainer.innerHTML = "";

            // Toggle trạng thái nút bấm
            if (currentDateMode === 'today') {
                btnFilterToday.classList.add("active");
                btnFilterAll.classList.remove("active");
            } else {
                btnFilterToday.classList.remove("active");
                btnFilterAll.classList.add("active");
            }

            const selectedDate = searchDateInput.value;
            const selectedStatus = statusFilterSelect.value;
            let hasVisibleItems = false;

            rawItems.forEach(item => {
                const itemDateISO = item.getAttribute("data-date-iso");
                const itemStatus = item.getAttribute("data-status");

                let dateMatches = (currentDateMode === 'all') || (itemDateISO === selectedDate);
                let statusMatches = (selectedStatus === 'all') || (itemStatus === selectedStatus);

                if (dateMatches && statusMatches) {
                    hasVisibleItems = true;
                    // Nối thẻ lịch hẹn liên tục vào Grid (1 2 3 4 / 5 6...)
                    const clonedCardCol = item.firstElementChild.cloneNode(true);
                    gridContainer.appendChild(clonedCardCol);
                }
            });

            if (!hasVisibleItems) {
                noResultsScreen.style.display = "block";
            } else {
                noResultsScreen.style.display = "none";
            }
        }

        searchDateInput.addEventListener("change", function() {
            if (searchDateInput.value) {
                currentDateMode = 'today';
            }
            filterAndGroupAppointments();
        });

        statusFilterSelect.addEventListener("change", function() {
            filterAndGroupAppointments();
        });

        btnFilterToday.addEventListener("click", function() {
            currentDateMode = 'today';
            searchDateInput.value = todayISOStr;
            filterAndGroupAppointments();
        });

        btnFilterAll.addEventListener("click", function() {
            currentDateMode = 'all';
            searchDateInput.value = '';
            filterAndGroupAppointments();
        });

        btnResetSearch.addEventListener("click", function() {
            currentDateMode = 'all';
            statusFilterSelect.value = 'all';
            searchDateInput.value = '';
            filterAndGroupAppointments();
        });

        filterAndGroupAppointments();
    });
</script>